wd_sector <- function(wd) {
  out <- cut(
    wd,
    breaks = c(0,45,90,135,180,225,270,315,360),
    labels = c("N","NE","E","SE","S","SW","W","NW"),
    include.lowest = TRUE
  )
  out <- as.character(out)
  out[is.na(out)] <- "Missing"
  factor(out, levels = c("N","NE","E","SE","S","SW","W","NW","Missing"))
}

local_bbox_ll <- function(pt_m, match_dist_m, local_pad_m) {
  bb <- sf::st_bbox(pt_m)
  bb[c("xmin","ymin")] <- bb[c("xmin","ymin")] - (match_dist_m + local_pad_m)
  bb[c("xmax","ymax")] <- bb[c("xmax","ymax")] + (match_dist_m + local_pad_m)
  sf::st_bbox(sf::st_transform(sf::st_as_sfc(bb), 4326))
}

