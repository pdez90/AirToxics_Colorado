# ----------------------------
# 10) PER-HOTSPOT LOOP
# ----------------------------
for (gid in sort(unique(master$group_id))) {

  message("\n--- group_id = ", gid, " ---")

  pt_m <- master_sf_m %>% dplyr::filter(group_id == gid)
  if (nrow(pt_m) == 0) next

  d_m <- as.numeric(sf::st_distance(df_sf_m, pt_m))
  idx <- which(d_m <= match_dist_m)

  message("  Mobile rows within ", match_dist_m, " m: ", length(idx))
  if (length(idx) == 0) next

  df_hot <- df[idx, , drop = FALSE]

  out_map_local <- file.path(out_dir, paste0("group_", gid, "_map_local.png"))
  ragg::agg_png(out_map_local, width = 6.8, height = 6.8, units = "in", res = 300, background = "white")
  print(make_map_local(gid, tile_zoom_local))
  dev.off()

  out_pairs <- file.path(out_dir, paste0("group_", gid, "_pairwise_wd.png"))
  ppairs <- make_pairwise_panel(df_hot, gid)
  if (!is.null(ppairs)) {
    ragg::agg_png(out_pairs, width = 12.5, height = 9.8, units = "in", res = 300, background = "white")
    print(ppairs)
    dev.off()
  } else {
    message("  (pairwise) skipped: too few rows or too few usable pollutant columns.")
  }

  out_polar <- file.path(out_dir, paste0("group_", gid, "_polar_nwr.png"))
  if (all(c("ws","wd") %in% names(df_hot)) && length(pollutant_cols_existing) > 0) {
    ragg::agg_png(out_polar, width = 6.8, height = 6.8, units = "in", res = 300, background = "white")
    print(openair::polarPlot(
      mydata    = df_hot,
      pollutant = pollutant_cols_existing,
      statistic = "nwr",
      main = paste0("Polar plots (nwr) within 100 m | group ", gid)
    ))
    dev.off()
  } else {
    message("  (polar nwr) skipped: ws/wd missing or no pollutant cols.")
  }

  save_cpf_and_mean_polar(df_hot, gid, out_dir)

  rs <- ratio_summary(df_hot)
  if (nrow(rs) > 0) {
    rs <- rs %>% dplyr::mutate(group_id = gid, .before = 1)
    out_ratio_csv <- file.path(out_dir, paste0("group_", gid, "_ratio_summary.csv"))
    readr::write_csv(rs, out_ratio_csv)
    message("  [Saved] ", out_ratio_csv)
  }

  out_hour <- file.path(out_dir, paste0("group_", gid, "_hour_activity.png"))
  ragg::agg_png(out_hour, width = 7.5, height = 8.5, units = "in", res = 300, background = "white")
  print(make_hour_plots(df_hot, gid))
  dev.off()
}

