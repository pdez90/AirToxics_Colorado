make_ratio_heatmap <- function(ratio_all_df) {
  if (nrow(ratio_all_df) == 0) {
    return(ggplot2::ggplot() + ggplot2::theme_void() + ggplot2::labs(title = "Ratio heatmap (no data)"))
  }

  ratio_med <- ratio_all_df %>%
    dplyr::select(group_id, ratio, median) %>%
    dplyr::mutate(
      ratio = dplyr::recode(ratio,
                            T_B   = "Toluene/Benzene",
                            X_B   = "Xylene/Benzene",
                            TMB_B = "TMB/Benzene",
                            H2S_B = "H2S/Benzene",
                            HCN_B = "HCN/Benzene")
    )

  ggplot2::ggplot(ratio_med, ggplot2::aes(x = ratio, y = factor(group_id), fill = median)) +
    ggplot2::geom_tile() +
    ggplot2::theme_bw() +
    ggplot2::theme(axis.text.x = ggplot2::element_text(angle = 30, hjust = 1)) +
    ggplot2::labs(
      title = "Median pollutant ratios by hotspot",
      x = "Ratio",
      y = "Hotspot group",
      fill = "Median"
    )
}

