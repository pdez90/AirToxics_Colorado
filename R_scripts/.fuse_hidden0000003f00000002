save_cpf_and_mean_polar <- function(df_hot, gid, out_dir) {
  if (nrow(df_hot) < min_rows_per_hotspot) return(invisible(NULL))
  if (!all(c("ws","wd") %in% names(df_hot))) return(invisible(NULL))

  for (cc in pollutant_cols_existing) {
    if (sum(is.finite(df_hot[[cc]])) < 10) next

    thr <- global_thr[[cc]]
    out_png <- file.path(out_dir, paste0("group_", gid, "_CPF_", pretty_pollutants[[cc]], ".png"))

    res1 <- try({
      ragg::agg_png(out_png, width = 6.5, height = 6.5, units = "in", res = 300, background = "white")
      print(openair::polarPlot(
        mydata    = df_hot,
        pollutant = cc,
        statistic = "cpf",
        threshold = thr,
        main = paste0("CPF (global p", round(cpf_global_quantile*100), ") | ", pretty_pollutants[[cc]], " | group ", gid)
      ))
      dev.off()
    }, silent = TRUE)

    if (inherits(res1, "try-error")) {
      try({
        ragg::agg_png(out_png, width = 6.5, height = 6.5, units = "in", res = 300, background = "white")
        print(openair::polarPlot(
          mydata     = df_hot,
          pollutant  = cc,
          statistic  = "cpf",
          percentile = cpf_fallback_percentile,
          main = paste0("CPF (p", cpf_fallback_percentile, ") | ", pretty_pollutants[[cc]], " | group ", gid)
        ))
        dev.off()
      }, silent = TRUE)
    }

    out_mean <- file.path(out_dir, paste0("group_", gid, "_PolarMean_", pretty_pollutants[[cc]], ".png"))
    try({
      ragg::agg_png(out_mean, width = 6.5, height = 6.5, units = "in", res = 300, background = "white")
      print(openair::polarPlot(
        mydata    = df_hot,
        pollutant = cc,
        statistic = "mean",
        main = paste0("Polar mean | ", pretty_pollutants[[cc]], " | group ", gid)
      ))
      dev.off()
    }, silent = TRUE)
  }

  invisible(NULL)
}

ratio_summary <- function(df_hot) {
  safe_ratio <- function(num, den) ifelse(is.finite(num) & is.finite(den) & den > 0, num/den, NA_real_)

  cols <- names(df_hot)

  if ("Toluene_ppb" %in% cols && "Benzene_ppb" %in% cols) df_hot$T_B   <- safe_ratio(df_hot$Toluene_ppb, df_hot$Benzene_ppb)
  if ("Xylene_ppb" %in% cols  && "Benzene_ppb" %in% cols) df_hot$X_B   <- safe_ratio(df_hot$Xylene_ppb,  df_hot$Benzene_ppb)
  if ("Trimethylbenzene_ppb" %in% cols && "Benzene_ppb" %in% cols) df_hot$TMB_B <- safe_ratio(df_hot$Trimethylbenzene_ppb, df_hot$Benzene_ppb)
  if ("Hydrogen_Sulfide_ppb" %in% cols && "Benzene_ppb" %in% cols) df_hot$H2S_B <- safe_ratio(df_hot$Hydrogen_Sulfide_ppb, df_hot$Benzene_ppb)
  if ("Hydrogen_Cyanide_ppb" %in% cols && "Benzene_ppb" %in% cols) df_hot$HCN_B <- safe_ratio(df_hot$Hydrogen_Cyanide_ppb, df_hot$Benzene_ppb)

  ratio_cols <- intersect(c("T_B","X_B","TMB_B","H2S_B","HCN_B"), names(df_hot))
  if (length(ratio_cols) == 0) return(tibble::tibble())

  dplyr::bind_rows(lapply(ratio_cols, function(rc) {
    x <- df_hot[[rc]]
    tibble::tibble(
      ratio = rc,
      n_nonmiss = sum(is.finite(x)),
      median = stats::median(x, na.rm = TRUE),
      p25 = as.numeric(stats::quantile(x, 0.25, na.rm = TRUE)),
      p75 = as.numeric(stats::quantile(x, 0.75, na.rm = TRUE)),
      p95 = as.numeric(stats::quantile(x, 0.95, na.rm = TRUE))
    )
  }))
}

make_pairwise_panel <- function(df_hot, gid) {
  if (nrow(df_hot) < min_rows_per_hotspot) return(NULL)
  if (!all(c("ws","wd") %in% names(df_hot))) return(NULL)

  df_hot <- df_hot %>% dplyr::mutate(wd_sector = wd_sector(wd))

  pol_cols <- pollutant_cols_existing
  pol_cols <- pol_cols[vapply(pol_cols, function(cc) {
    z <- df_hot[[cc]]
    is.numeric(z) && sum(is.finite(z)) >= 10 && stats::sd(z, na.rm = TRUE) > 0
  }, logical(1))]
  if (length(pol_cols) < 2) return(NULL)

  pairs <- utils::combn(pol_cols, 2, simplify = FALSE)

  one_plot <- function(xcol, ycol) {
    ggplot2::ggplot(df_hot, ggplot2::aes(x = .data[[xcol]], y = .data[[ycol]], color = wd_sector)) +
      ggplot2::geom_point(ggplot2::aes(size = ws), alpha = 0.8) +
      ggplot2::scale_size_continuous(range = c(0.6, 2.0), guide = "none") +
      ggplot2::theme_bw() +
      ggplot2::theme(
        plot.margin = ggplot2::margin(14, 22, 14, 14, "pt"),
        legend.position = "right"
      ) +
      ggplot2::labs(
        title = paste0(pretty_pollutants[[xcol]], " vs ", pretty_pollutants[[ycol]]),
        x = pretty_pollutants[[xcol]],
        y = pretty_pollutants[[ycol]],
        color = "Wind Direction"
      )
  }

  plots <- lapply(pairs, function(pr) one_plot(pr[1], pr[2]))

  title <- cowplot::ggdraw() +
    cowplot::draw_label(
      paste0("Pairwise pollutant scatterplots colored by wind direction\nwithin 100 m | group ", gid, " | n=", nrow(df_hot)),
      fontface = "bold", x = 0.5, hjust = 0.5, size = 12
    )

  panel <- cowplot::plot_grid(plotlist = plots, ncol = 3, align = "hv")
  cowplot::plot_grid(title, panel, ncol = 1, rel_heights = c(0.08, 1))
}

make_hour_plots <- function(df_hot, gid) {
  p_count <- df_hot %>%
    dplyr::count(hour) %>%
    ggplot2::ggplot(ggplot2::aes(hour, n)) +
    ggplot2::geom_col() +
    ggplot2::theme_bw() +
    ggplot2::labs(
      title = paste0("Hotspot activity by hour | group ", gid),
      subtitle = "Count of mobile measurements within 100 m",
      x = "Hour of day", y = "Count"
    )

  p_frac <- df_hot %>%
    dplyr::group_by(hour) %>%
    dplyr::summarise(
      n = dplyr::n(),
      frac_any_high = mean(any_high_global, na.rm = TRUE),
      .groups = "drop"
    ) %>%
    ggplot2::ggplot(ggplot2::aes(hour, frac_any_high)) +
    ggplot2::geom_line() +
    ggplot2::geom_point() +
    ggplot2::theme_bw() +
    ggplot2::labs(
      title = paste0("High-concentration probability by hour | group ", gid),
      subtitle = paste0("Fraction with any pollutant > global p", round(cpf_global_quantile*100), " threshold"),
      x = "Hour of day", y = "Fraction high"
    )

  cowplot::plot_grid(p_count, p_frac, ncol = 1, rel_heights = c(1, 1))
}

# ----------------------------
# 7) PRECOMPUTE: per-hotspot subsets + ratio + hour activity
# ----------------------------
all_ratio_summ <- list()
all_hour_activity <- list()
all_hotspot_metrics <- list()

for (gid in sort(unique(master$group_id))) {
  pt_m <- master_sf_m %>% dplyr::filter(group_id == gid)
  if (nrow(pt_m) == 0) next

  d_m <- as.numeric(sf::st_distance(df_sf_m, pt_m))
  idx <- which(d_m <= match_dist_m)
  if (length(idx) == 0) next

  df_hot <- df[idx, , drop = FALSE]

  rs <- ratio_summary(df_hot)
  if (nrow(rs) > 0) {
    rs <- rs %>% dplyr::mutate(group_id = gid, .before = 1)
    all_ratio_summ[[length(all_ratio_summ) + 1]] <- rs
  }

  ha <- df_hot %>%
    dplyr::group_by(hour) %>%
    dplyr::summarise(
      n = dplyr::n(),
      frac_any_high = mean(any_high_global, na.rm = TRUE),
      .groups = "drop"
    ) %>%
    dplyr::mutate(group_id = gid, .before = 1)

  all_hour_activity[[length(all_hour_activity) + 1]] <- ha

  all_hotspot_metrics[[length(all_hotspot_metrics) + 1]] <- tibble::tibble(
    group_id = gid,
    n_mobile_rows_100m = nrow(df_hot),
    n_unique_days_100m = dplyr::n_distinct(df_hot$day),
    n_unique_hours_100m = dplyr::n_distinct(df_hot$hour),
    frac_any_high_100m = mean(df_hot$any_high_global, na.rm = TRUE)
  )
}

ratio_all <- if (length(all_ratio_summ) > 0) dplyr::bind_rows(all_ratio_summ) else tibble::tibble()
hour_all  <- if (length(all_hour_activity) > 0) dplyr::bind_rows(all_hour_activity) else tibble::tibble()
hotspot_metrics <- if (length(all_hotspot_metrics) > 0) dplyr::bind_rows(all_hotspot_metrics) else tibble::tibble()

if (nrow(ratio_all) > 0) {
  out_ratio_all <- file.path(out_dir, "hotspot_ratio_summary_ALL.csv")
  readr::write_csv(ratio_all, out_ratio_all)
  message("[Saved] ", out_ratio_all)
}
