    dplyr::mutate(pollutants = tolower(pollutants)) %>%
    tidyr::separate_rows(pollutants, sep = "\\+") %>%
    dplyr::mutate(pollutants = dplyr::case_when(
      pollutants == "h2s" ~ "H2S",
      pollutants == "hcn" ~ "HCN",
      pollutants == "trimethylbenzene" ~ "Trimethylbenzene",
      TRUE ~ stringr::str_to_title(pollutants)
